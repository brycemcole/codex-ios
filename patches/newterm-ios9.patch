--- /dev/null
+++ b/NewTerm/ios9-availability.c
@@ -0,0 +1,8 @@
+#include <stdint.h>
+struct build_version { uint32_t platform; uint32_t version; };
+int _availability_version_check(uint32_t count, const struct build_version versions[]) {
+    for (uint32_t i = 0; i < count; i++) {
+        if (versions[i].platform == 2) return versions[i].version <= 0x00090306;
+    }
+    return 0;
+}
