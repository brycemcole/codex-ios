@@ -7,6 +7,61 @@
 #import "FontMetrics.h"
 #import <version.h>
 
+static unichar CompatGlyph(unichar c) {
+	switch (c) {
+		case 0x00A0: return ' ';
+		case 0x00B7: return '.';
+		case 0x00D7: return 'x';
+		case 0x2013: case 0x2014: return '-';
+		case 0x2018: case 0x2019: return 0x27;
+		case 0x201C: case 0x201D: return '"';
+		case 0x2022: case 0x25CF: return '*';
+		case 0x2026: return '~';
+		case 0x2190: case 0x21D0: case 0x2B05: return '<';
+		case 0x2192: case 0x21D2: case 0x2B06: return '>';
+		case 0x2191: case 0x21D1: case 0x2B07: return '^';
+		case 0x2193: case 0x21D3: return 'v';
+		case 0x2502: case 0x2503: case 0x2507: case 0x2509: case 0x250B:
+		case 0x2551: return '|';
+		case 0x2500: case 0x2501: case 0x2504: case 0x2505: case 0x2506:
+		case 0x2508: case 0x250A: case 0x254C: case 0x254D: case 0x2550: return '-';
+		case 0x2571: return '/';
+		case 0x2572: return 0x5C;
+		case 0x2573: return 'X';
+		case 0x2588: case 0x2580: case 0x2584: case 0x258C: case 0x2590: return '#';
+		case 0x2591: return '.';
+		case 0x2592: return ':';
+		case 0x2593: case 0x2581: case 0x2582: case 0x2583: case 0x2585:
+		case 0x2586: case 0x2587: case 0x2589: case 0x258A: case 0x258B:
+		case 0x258D: case 0x258E: case 0x258F: case 0x2594: case 0x2595:
+		case 0x2596: case 0x2597: case 0x2598: case 0x2599: case 0x259A:
+		case 0x259B: case 0x259C: case 0x259D: case 0x259E: case 0x259F: return '#';
+		case 0x25A0: case 0x25A1: case 0x25AA: case 0x25AB: return '#';
+		case 0x25B2: case 0x25B4: return '^';
+		case 0x25BC: case 0x25BE: return 'v';
+		case 0x25C0: case 0x25C2: return '<';
+		case 0x25B6: case 0x25B8: return '>';
+		case 0x25CB: case 0x25E6: return 'o';
+		case 0x2713: case 0x2714: return 'v';
+		case 0x2715: case 0x2716: case 0x2717: case 0x2718: return 'x';
+		case 0x2800: return ' ';
+	}
+	if (c >= 0xD800 && c <= 0xDFFF) return '?';
+	if (c >= 0x2000 && c <= 0x200F) return ' ';
+	if (c >= 0x2020 && c <= 0x2044) return '*';
+	if (c >= 0x2028 && c <= 0x202F) return ' ';
+	if (c >= 0x2194 && c <= 0x21FF) return '*';
+	if (c >= 0x2400 && c <= 0x243F) return '*';
+	if (c >= 0x2460 && c <= 0x24FF) return '*';
+	if (c >= 0x250C && c <= 0x257F) return '+';
+	if (c >= 0x2800 && c <= 0x28FF) return '*';
+	if (c >= 0x2600 && c <= 0x27BF) return '*';
+	if (c >= 0x2B00 && c <= 0x2BFF) return '*';
+	if (c >= 0xFE00 && c <= 0xFE0F) return ' ';
+	if (c == 0xFEFF) return ' ';
+	return c;
+}
